# IDE / 工具数据目录不入库
.zcode/
.codebuddy/

# GitHub key 文件（保留，不入库）
# 原行 "/NUL" + 一段被误写为 UTF-16LE 的 evidence/*.json 残留已清；
# 见 commit 54af3de 历史。正式 evidence 规则见下方 evidence/**/*.json。

# Secrets: never commit real .env (INFRA-SEC-01)
.env
.env.*
!.env.example
ops/.env
ops/.env.*
!ops/.env.example

# Syncthing temporary files
~syncthing~*
*.syncthing


# CI-unpacked proprietary SDK headers (never commit DeckLink SDK assets)
.github/_private/

# CI 下发的二进制产物 / 下载目录（不入库；仅限根目录，勿误伤 services/media-agent 源码）
/media-agent
/.dl/
/.ci_tmp/

evidence/**/*.json

# build artifacts
*.tar.gz
**/graphify-out/
.codegraph/
.vscode/

# Node control-plane (apps/api) local artifacts — never commit
node_modules/
apps/api/dist/
apps/web-console/dist/
apps/web-console/node_modules/
npm-debug.log*

# Mimosa 安全扫描 hook 本地状态 (同 .codegraph: 本机文件不入库)。
.mimosa/
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<
packages/vbmf-sdk/dist/
