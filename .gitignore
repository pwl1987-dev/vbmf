# IDE / 工具数据目录不入库
.zcode/
.codebuddy/

# GitHub key 文件（保留，不入库）
# 原行 "/NUL" + 一段被误写为 UTF-16LE 的 evidence/*.json 残留已清；
# 见 commit 54af3de 历史。正式 evidence 规则见下方 evidence/**/*.json。

# Secrets: never commit real .env (INFRA-SEC-01)
.env
.env.*
!.env.example
ops/.env
ops/.env.*
!ops/.env.example

# Syncthing temporary files
~syncthing~*
*.syncthing


# CI-unpacked proprietary SDK headers (never commit DeckLink SDK assets)
.github/_private/

# CI 下发的二进制产物 / 下载目录（不入库；仅限根目录，勿误伤 services/media-agent 源码）
/media-agent
/.dl/
/.ci_tmp/

evidence/**/*.json

# Narrow exception (2026-11-27): PR-STAB-01 v3 ladder verdict JSONs (2h/8h/24h).
# These 7 files per rung are the judgment + provenance anchors (v3-summary verdict,
# v3-identity source/binary pin, teardown responses) and are listed in each rung's
# md5s.txt integrity record -> they must be byte-exact in Git. Explicit per-file
# allowlist on purpose: do NOT widen to all evidence JSON (keeps the UTF-16LE
# incident guard of commit 54af3de intact).
!evidence/bmd-10.30.15.10/2026-11-25-pr-stab-01-v3-*/health.json
!evidence/bmd-10.30.15.10/2026-11-25-pr-stab-01-v3-*/health0.json
!evidence/bmd-10.30.15.10/2026-11-25-pr-stab-01-v3-*/runtime-before.json
!evidence/bmd-10.30.15.10/2026-11-25-pr-stab-01-v3-*/stop-response.json
!evidence/bmd-10.30.15.10/2026-11-25-pr-stab-01-v3-*/v3-identity.json
!evidence/bmd-10.30.15.10/2026-11-25-pr-stab-01-v3-*/v3-postrun.json
!evidence/bmd-10.30.15.10/2026-11-25-pr-stab-01-v3-*/v3-summary.json

# build artifacts
*.tar.gz
**/graphify-out/
.codegraph/
.vscode/*
!.vscode/settings.json

# Node control-plane (apps/api) local artifacts — never commit
node_modules/
apps/api/dist/
apps/web-console/dist/
apps/web-console/node_modules/
npm-debug.log*

# Mimosa 安全扫描 hook 本地状态 (同 .codegraph: 本机文件不入库)。
.mimosa/
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
# <<< Comet managed project state <<<
packages/vbmf-sdk/dist/

# Python bytecode cache (r64-probe 本地运行产物，不入库)
__pycache__/
