# VBMF self-hosted GitHub Actions runner — systemd template unit
# Contract: docs/architecture/CI_RUNNER_STRATEGY.md §7 (CI-RUNNER-SYSTEMD-01)
#
# Single lifecycle owner for all VBMF runners. provision-runner.sh does NOT
# call `svc.sh install`; this template is the only service definition.
#
# Install (diff first — never silently overwrite local modifications):
#   diff /etc/systemd/system/actions-runner-vbmf@.service ./actions-runner-vbmf@.service || true
#   cp ./actions-runner-vbmf@.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now actions-runner-vbmf@vbmf-ci-01.service
#
# %i expands to the runner directory name under
# /data/actions-runners/vbmf/runners/ (e.g. vbmf-ci-01).
#
# CI-RUNNER-SEC-01 v2: no proxy Environment= entries here. Managed runtime
# proxy belongs to the runner application .env and must be credential-free
# loopback HTTP; KVM guests use a host-local forward. See strategy §5.

[Unit]
Description=VBMF self-hosted GitHub Actions runner (%i)
Documentation=https://github.com/pwl1987-dev/vbmf/blob/main/docs/architecture/CI_RUNNER_STRATEGY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vbmf-ci
Group=vbmf-ci
WorkingDirectory=/data/actions-runners/vbmf/runners/%i
ExecStart=/data/actions-runners/vbmf/runners/%i/run.sh

# Restart discipline (CI-RUNNER-SYSTEMD-01)
Restart=always
RestartSec=5

# The runner handles SIGINT graceful shutdown; SIGTERM would abort jobs.
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=10min

# Pinned environment (CI-RUNNER-SEC-01: deliberately minimal, proxy-free)
Environment=HOME=/data/actions-runners/vbmf/runners/%i
Environment=LANG=en_US.UTF-8
# Required for graceful shutdown: run.sh's default mode runs run-helper.sh in
# the foreground WITHOUT any signal trap — under KillMode=process the SIGINT
# reaches only run.sh and deadlocks until the TimeoutStopSec SIGKILL
# (observed: 10min hang in the 2026-09-11 F-drill). With this flag run.sh
# uses runWithManualTrap (trap INT TERM -> kill -INT process group), which is
# exactly what the official svc.sh-generated service does via runsvc.sh.
Environment=RUNNER_MANUALLY_TRAP_SIG=1

# NOTE: intentionally NO extra hardening (NoNewPrivileges/ProtectSystem etc.)
# here: existing jobs (e.g. gstreamer-build) use `sudo apt-get install`, which
# such options would break. Revisit only in the Phase 2 migration review.

[Install]
WantedBy=multi-user.target
