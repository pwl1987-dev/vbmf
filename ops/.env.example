# VBMF Deployment Secrets Template (INFRA-SEC-01)
# Copy to .env and fill REAL values. .env is gitignored - NEVER commit real secrets.
# For ACCEPTANCE/PROD use dedicated .env.acceptance / .env.prod via SSH provisioning.

# ---- CORE (required: the core stack fail-closes without these) ----
# PostgreSQL — the Fastify control plane's only external dependency (PR-01A)
POSTGRES_USER=vbmf
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=vbmf
# Better Auth (CP-01C fail-closed: fastify refuses to boot unconfigured)
BETTER_AUTH_SECRET=CHANGE_ME_strong_secret

# ---- OPTIONAL capability: storage profile (rustfs) ----
# Consumed only by `--profile storage`; leave unset for a core-only deployment.
RUSTFS_ACCESS=vbmf
RUSTFS_SECRET=CHANGE_ME_strong_secret
