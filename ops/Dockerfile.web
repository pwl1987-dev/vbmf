# VBMF Web Console (WEB-CONSOLE-ENTRY-01 / WCE-01B · Deployment SoT §4).
#
# Multi-stage: Node 24 build → nginx:1.27-alpine runtime serving dist/.
# Build context = repo root (`..`) so Dockerfile can COPY apps/web-console/.
# nginx upstream `web:5173` in ops/nginx/default.conf proxies `/` to this
# container. Browser only sees same-origin /api/, /events/, /health/.
#
# Frozen Architecture (§3.79 + frozen Deployment SoT §4):
# - 浏览器零直连 media-agent（§C13）：vite 不暴露 agent host / 50051 / /internal/；
# - 不打包 ffmpeg / gstreamer / DeckLink / /dev/blackmagic（F12 red lines）；
# - Build env no VITE_API_BASE 等代理配置——browser 用相对路径 + Nginx。
#
# DEPLOY-BASELINE: Node 24 Active LTS; nginx:1.27-alpine 与 ops/nginx/default.conf 同版本。

# ---------- build stage ----------
FROM node:24-alpine AS build
WORKDIR /src

# Install deps first for layer cache; lockfile-pinned via package-lock.json.
COPY apps/web-console/package.json apps/web-console/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Copy source (Vite handles TS/JSX transforms).
COPY apps/web-console/ ./

# Build production bundle. Vite builds into dist/ (configured in vite.config.ts).
RUN npm run build

# ---------- runtime stage ----------
FROM nginx:1.27-alpine

# Drop default nginx config and serve Vite dist/.
RUN rm /etc/nginx/conf.d/default.conf
COPY ops/nginx/web.conf /etc/nginx/conf.d/default.conf

# Static assets from build stage.
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 5173

# 127.0.0.1 literal (not "localhost"): busybox wget resolves localhost to
# ::1 first on some hosts while nginx historically listened IPv4-only —
# the flapping connection-refused healthcheck found in BMD acceptance
# (WEB-CONSOLE-BMD-ACCEPTANCE-01). web.conf now dual-stacks 5173 as well.
HEALTHCHECK --interval=10s --timeout=3s --retries=5 --start-period=10s \
  CMD wget -qO- http://127.0.0.1:5173/ >/dev/null || exit 1
