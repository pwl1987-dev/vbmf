# VBMF Web Console (WEB-CONSOLE-ENTRY-01 / WCE-01B · SDK-01D dogfood).
#
# Multi-stage: Node 24 build → nginx:1.27-alpine runtime serving dist/.
# Build context = repo root (`..`)。SDK-01D 起 Web Console transport/types
# 来自 @vbmf/sdk（file: 依赖）—— 镜像构建先构建 SDK（build:tsc：使用
# committed generated types，不重跑 gen:types —— 发布物构建不依赖
# apps/api 源码），再构建 Web Console（file: symlink 生效）。
# nginx upstream `web:5173` in ops/nginx/default.conf proxies `/` to this
# container. Browser only sees same-origin /api/, /events/, /health/.
#
# Frozen Architecture（§3.79 + frozen Deployment SoT §4）:
# - 浏览器零直连 media-agent（§C13）：vite 不暴露 agent host / 内部面 / 设备路径；
# - 不打包媒体进程/设备/DB 依赖（F12 red lines）；
# - Build env no VITE_API_BASE 等代理配置——browser 用相对路径 + Nginx。

# ---------- build stage ----------
FROM node:24-alpine AS build
WORKDIR /repo

# 1) SDK（file: 依赖目标必须先存在且含 dist）
COPY packages/vbmf-sdk/package.json packages/vbmf-sdk/package-lock.json ./packages/vbmf-sdk/
RUN cd packages/vbmf-sdk && npm ci --no-audit --no-fund
COPY packages/vbmf-sdk/tsconfig.json packages/vbmf-sdk/tsconfig.build.json packages/vbmf-sdk/vite.config.ts ./packages/vbmf-sdk/
COPY packages/vbmf-sdk/src ./packages/vbmf-sdk/src
RUN cd packages/vbmf-sdk && npm run build:tsc

# 2) Web Console（node_modules 中 @vbmf/sdk symlink 指向上一步产物）
COPY apps/web-console/package.json apps/web-console/package-lock.json ./apps/web-console/
RUN cd apps/web-console && npm ci --no-audit --no-fund
COPY apps/web-console/ ./apps/web-console/
RUN cd apps/web-console && npm run build

# ---------- runtime stage ----------
FROM nginx:1.27-alpine

# Drop default nginx config and serve Vite dist/.
RUN rm /etc/nginx/conf.d/default.conf
COPY ops/nginx/web.conf /etc/nginx/conf.d/default.conf

# Static assets from build stage. chmod: the repo tree is setgid — files
# arrive group-readable-only and the unprivileged nginx worker gets EACCES
# (found by the SDK-01D dogfood container smoke).
COPY --from=build /repo/apps/web-console/dist /usr/share/nginx/html
RUN chmod -R a+rX /usr/share/nginx/html

EXPOSE 5173

# 127.0.0.1 literal (not "localhost"): busybox wget resolves localhost to
# ::1 first on some hosts while nginx historically listened IPv4-only —
# the flapping connection-refused healthcheck found in BMD acceptance
# (WEB-CONSOLE-BMD-ACCEPTANCE-01). web.conf now dual-stacks 5173 as well.
HEALTHCHECK --interval=10s --timeout=3s --retries=5 --start-period=10s \
  CMD wget -qO- http://127.0.0.1:5173/ >/dev/null || exit 1
