# Force LF for all text files (cross-platform consistency)
* text=auto eol=lf

# Markdown
*.md text eol=lf

# YAML / JSON
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.rs text eol=lf
*.py text eol=lf
*.go text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.toml text eol=lf

# HTML / CSS
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

# LICENSE / config
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary (do not modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.zip binary

# Evidence archives: keep exact bytes from the source host
# (md5s.txt in each dir is the integrity record; CRLF must not be normalized)
evidence/**/*.csv -text
evidence/**/*.jsonl -text
# PR-STAB-01 v3 ladder verdict JSONs are covered by each rung's md5s.txt integrity
# record -> byte-exact, no line-ending normalization.
evidence/bmd-10.30.15.10/2026-11-25-pr-stab-01-v3-*/*.json -text
